# Extra environment variables for minimal_FrontierScience
# These are additional to EvoMaster-ours/.env.template.

# ========== FrontierScience Tool APIs ==========
# Required by search_web/google_scholar tools.
SERPER_API_KEY=
# Optional fallback key name accepted by google_scholar tool.
SERPER_KEY_ID=

# Optional for visit_web tool (Jina Reader API key).
JINA_API_KEY=

# Optional visit_web runtime controls.
VISIT_SERVER_TIMEOUT=360
VISIT_SERVER_MAX_RETRIES=3
WEBCONTENT_MAXLENGTH=150000

# ========== Optional script path overrides ==========
# By default, tools use builtin implementations in tools/*_tool.py.
# Set these only if you want to force an external script implementation.
FRONTIER_SEARCH_WEB_SCRIPT=
FRONTIER_GOOGLE_SCHOLAR_SCRIPT=
FRONTIER_VISIT_WEB_SCRIPT=
